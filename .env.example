# 复制为 .env 后按需修改；所有项都有默认值，不创建 .env 也能运行（AI 自动降级）。
# 对应 docs/01-spec.md §7.2、docs/03-architecture.md §10.3。

# 服务
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai

# 数据库（相对路径以项目根目录为基准）
DATABASE_PATH=./data/app.db
DB_BUSY_TIMEOUT_MS=5000

# 业务规则
CHECKIN_OPEN_BEFORE_MINUTES=30
CAPACITY_MAX=1000
TITLE_MAX_LEN=50
SUMMARY_MAX_LEN=500
NOTES_MAX_ITEMS=5
NOTE_MAX_LEN=100
TAGS_MIN=1
TAGS_MAX=5

# AI（DeepSeek，OpenAI 兼容接口）。密钥留空即使用本地规则/模板降级。
AI_TIMEOUT_SECONDS=15
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
